{
  "name": "stadevoice-backend",
  "version": "1.0.0",
  "description": "Backend API pour StadeVoice - Coupe du Monde 2030",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "seed": "node prisma/seed.js",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "setup": "npx prisma generate && npx prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
